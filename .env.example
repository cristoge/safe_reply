POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DB
REDIS_URL=redis://localhost:6379/0
# development: activa las rutas de desarrollo (p. ej. GET /api/v1/users).
ENVIRONMENT=development
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Nivel de los logs de la app (JSON por stdout): DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
